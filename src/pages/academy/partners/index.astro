---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InternalHero from '../../../components/InternalHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Button from '../../../components/Button.astro';
import FootballMarker from '../../../components/shared/FootballMarker.astro';
import hero from '../../../assets/images/gallery/recent-event/team-huddle-01.jpg';
import developmentImage from '../../../assets/images/gallery/recent-event/coach-instruction-02.jpg';
import communityImage from '../../../assets/images/gallery/recent-event/academy-community-03.jpg';
import academyLogo from '../../../assets/brand/dante-football-academy.png';
import { contact } from '../../../data/contact';
import { site } from '../../../data/site';
import {
  communityAmbitions,
  developmentPillars,
  evaluationCriteria,
  partnershipBenefits,
  partnershipOpportunities,
  partnershipPathway,
} from '../../../data/partners';
---

<BaseLayout
  title="Partners & Sponsorship | Dante Football Academy"
  description="Partnership opportunities supporting player development, education and community value at Dante Football Academy."
>
  <InternalHero
    eyebrow="The Academy / Partners & Sponsorship"
    title="Building opportunities through football."
    description="Dante Football Academy welcomes partnerships that strengthen player development, expand opportunity and create lasting value for young people, communities and organisations."
    image={hero}
    objectPosition="50% 50%"
  />

  <section class="identity-strip" aria-label="Organisation details">
    <div class="container identity-inner">
      <div>
        <Image src={academyLogo} alt="" width={58} height={58} />
        <p><strong>{site.name}</strong><span>Partner with DANTE</span></p>
      </div>
      <p>{site.legalName} <span>|</span> {site.registrationNumber}</p>
    </div>
  </section>

  <section class="section section--white why-partner">
    <div class="container">
      <SectionHeading
        eyebrow="Why partner with Dante"
        title="Shared purpose. Responsible value."
        intro="We welcome organisations whose goals align with player development, education, opportunity and positive community participation."
      />
      <div class="benefit-grid">
        {
          partnershipBenefits.map((benefit) => (
            <article>
              <FootballMarker variant="dark" />
              <h3>{benefit.title}</h3>
              <p>{benefit.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section opportunities-section">
    <div class="container opportunities-layout">
      <div class="opportunities-heading">
        <SectionHeading
          eyebrow="Partnership opportunities"
          title="Different ways to support the mission"
          intro="Each partnership should be shaped around shared priorities, suitable contribution and clear expectations."
        />
        <p class="source-note">
          Partnership scope and commitments are discussed individually. No
          standard sponsorship tiers or guaranteed outcomes are offered here.
        </p>
      </div>
      <ol class="opportunity-list">
        {
          partnershipOpportunities.map((opportunity, index) => (
            <li>
              <span aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <>
                  <h3>{opportunity.title}</h3>
                  <p>{opportunity.text}</p>
                </>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--navy clubs-section">
    <div class="container clubs-grid">
      <div>
        <SectionHeading
          eyebrow="For clubs & scouts"
          title="A development-led approach to talent"
          intro="DANTE's approach connects talent identification with structured technical, tactical, physical and personal development. Monitoring and holistic assessment help inform appropriate next steps without guaranteeing selection, transfer or placement."
          light
        />
        <a class="text-link" href="/programmes/">Explore our programmes</a>
      </div>
      <figure>
        <Image
          src={developmentImage}
          alt="A coach guiding a player during a Dante development session"
          widths={[560, 820, 1100]}
          sizes="(max-width: 760px) calc(100vw - 28px), 48vw"
          loading="lazy"
        />
        <span class="dante-diagonal-accent" aria-hidden="true"></span>
      </figure>
    </div>
    <div class="container evaluation-block">
      <div>
        <p class="eyebrow">Holistic evaluation</p>
        <h3>What player assessment may consider</h3>
      </div>
      <ul>{evaluationCriteria.map((criterion) => <li>{criterion}</li>)}</ul>
    </div>
  </section>

  <section class="section pathway-section">
    <div class="container">
      <SectionHeading
        eyebrow="Player development pathway"
        title="A purposeful route from potential to opportunity"
        intro="This pathway describes DANTE's development approach. It does not promise a professional contract or a particular destination."
      />
      <ol class="partner-pathway">
        {
          partnershipPathway.map((stage, index) => (
            <li>
              <span class="pathway-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <strong>{stage}</strong>
              {index < partnershipPathway.length - 1 && (
                <span class="pathway-line" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--white approach-section">
    <div class="container">
      <SectionHeading
        eyebrow="Dante's development approach"
        title="What a partner would be supporting"
      />
      <div class="pillar-grid">
        {
          developmentPillars.map((pillar) => (
            <article>
              <>
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section community-value">
    <div class="container community-grid">
      <figure>
        <Image
          src={communityImage}
          alt="Members of the Dante academy community together at a recent event"
          widths={[560, 820, 1100]}
          sizes="(max-width: 760px) calc(100vw - 28px), 48vw"
          loading="lazy"
        />
      </figure>
      <div>
        <SectionHeading
          eyebrow="Community and social value"
          title="Football that contributes beyond the pitch"
          intro="DANTE aims to use football as a platform for young people and communities to learn, participate and grow. Partnerships can support ambitions including:"
        />
        <ul>{communityAmbitions.map((ambition) => <li>{ambition}</li>)}</ul>
        <a class="text-link text-link--dark" href="/safeguarding/">
          Read our Safeguarding &amp; Child Protection commitment
        </a>
      </div>
    </div>
  </section>

  <section class="partnership-cta">
    <div class="container cta-grid">
      <div>
        <p class="eyebrow">Start a conversation</p><h2>
          Let's build opportunity together.
        </h2>
      </div>
      <div>
        <p>
          We welcome appropriate enquiries from sponsors, clubs, scouts,
          schools, technical organisations and community partners.
        </p>
        <div class="cta-actions">
          <Button href={contact.partnershipEnquiryHref}
            >Discuss a Partnership</Button
          >
          <Button href="/contact/" variant="outline">Contact the Academy</Button
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .identity-strip {
    background: var(--navy-900);
    color: white;
    border-bottom: 1px solid #2c324d;
  }
  .identity-inner,
  .identity-inner > div {
    display: flex;
    align-items: center;
  }
  .identity-inner {
    min-height: 88px;
    justify-content: space-between;
    gap: 28px;
  }
  .identity-inner > div {
    gap: 14px;
  }
  .identity-inner p,
  .identity-inner strong,
  .identity-inner span {
    display: block;
    margin: 0;
  }
  .identity-inner strong {
    font: 700 1.05rem 'Barlow Condensed';
    text-transform: uppercase;
  }
  .identity-inner span,
  .identity-inner > p {
    color: #aeb2c0;
    font-size: 0.74rem;
  }
  .identity-inner > p span {
    display: inline;
    padding-inline: 8px;
    color: var(--orange-500);
  }
  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid var(--navy-900);
  }
  .benefit-grid article {
    min-width: 0;
    padding: 30px 24px;
    border-right: 1px solid var(--grey-200);
  }
  .benefit-grid article:last-child {
    border-right: 0;
  }
  .benefit-grid :global(.football-marker) {
    color: var(--orange-500);
  }
  .benefit-grid h3,
  .pillar-grid h3 {
    margin: 38px 0 10px;
    font: 700 1.45rem/1 'Barlow Condensed';
    text-transform: uppercase;
  }
  .benefit-grid p,
  .pillar-grid p {
    margin: 0;
    color: var(--grey-600);
    font-size: 0.84rem;
  }
  .opportunities-section,
  .community-value {
    background: var(--off-white);
  }
  .opportunities-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 9%;
    align-items: start;
  }
  .opportunities-heading {
    position: sticky;
    top: 24px;
  }
  .source-note {
    padding-left: 18px;
    border-left: 3px solid var(--orange-500);
    color: var(--grey-600);
    font-size: 0.78rem;
  }
  .opportunity-list {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--navy-900);
  }
  .opportunity-list li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--grey-200);
  }
  .opportunity-list li > span {
    color: var(--orange-600);
    font: 700 0.68rem 'Inter';
    letter-spacing: 0.1em;
  }
  .opportunity-list h3 {
    margin: 0;
    font: 700 1.3rem 'Barlow Condensed';
    text-transform: uppercase;
  }
  .opportunity-list p {
    margin: 5px 0 0;
    color: var(--grey-600);
    font-size: 0.82rem;
  }
  .clubs-grid,
  .community-grid,
  .cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8%;
    align-items: center;
  }
  .clubs-grid figure,
  .community-grid figure {
    position: relative;
    overflow: hidden;
    margin: 0;
    aspect-ratio: 4/3;
  }
  .clubs-grid figure :global(img),
  .community-grid figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text-link {
    color: var(--orange-500);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .text-link:hover {
    color: white;
  }
  .text-link--dark:hover {
    color: var(--orange-600);
  }
  .evaluation-block {
    display: grid;
    grid-template-columns: minmax(240px, 0.4fr) 1fr;
    gap: 7%;
    margin-top: 70px;
    padding-top: 38px;
    border-top: 1px solid #343a55;
  }
  .evaluation-block h3 {
    margin: 0;
    font: 700 2rem/1 'Barlow Condensed';
    text-transform: uppercase;
  }
  .evaluation-block ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .evaluation-block li {
    padding: 9px 12px;
    border-bottom: 1px solid #343a55;
    color: #d3d5de;
    font-size: 0.82rem;
  }
  .pathway-section {
    background: #e8e6e0;
  }
  .partner-pathway {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .partner-pathway li {
    position: relative;
    min-width: 0;
    padding: 24px 20px;
    background: white;
    border-top: 3px solid var(--purple-700);
  }
  .partner-pathway li:nth-child(n + 5) {
    border-top-color: var(--orange-500);
  }
  .pathway-number,
  .partner-pathway strong {
    display: block;
  }
  .pathway-number {
    color: var(--orange-600);
    font-size: 0.65rem;
    font-weight: 700;
  }
  .partner-pathway strong {
    margin-top: 34px;
    font: 700 1.05rem/1.05 'Barlow Condensed';
    text-transform: uppercase;
  }
  .pathway-line {
    position: absolute;
    z-index: 2;
    top: 50%;
    right: -11px;
    width: 22px;
    height: 2px;
    background: var(--orange-500);
  }
  .pathway-line::after {
    content: '';
    position: absolute;
    top: -3px;
    right: 0;
    width: 7px;
    height: 7px;
    border-top: 2px solid var(--orange-500);
    border-right: 2px solid var(--orange-500);
    transform: rotate(45deg);
  }
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--grey-200);
  }
  .pillar-grid article {
    min-width: 0;
    padding: 28px;
    background: white;
  }
  .pillar-grid h3 {
    margin-top: 0;
  }
  .community-grid ul {
    padding: 0;
    margin: 0 0 22px;
    list-style: none;
    border-top: 1px solid var(--grey-200);
  }
  .community-grid li {
    padding: 10px 0;
    border-bottom: 1px solid var(--grey-200);
    font-size: 0.84rem;
  }
  .text-link--dark {
    color: var(--blue-700);
  }
  .partnership-cta {
    padding: var(--section-space) 0;
    background: var(--orange-500);
    color: white;
  }
  .cta-grid {
    align-items: end;
  }
  .partnership-cta .eyebrow {
    color: var(--navy-950);
  }
  .partnership-cta h2 {
    max-width: 720px;
    margin: 0;
    font: 800 clamp(3.4rem, 7vw, 6rem)/0.87 'Barlow Condensed';
    text-transform: uppercase;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .cta-actions :global(.button--primary) {
    background: var(--navy-950);
  }
  .cta-actions :global(.button--outline) {
    border-color: white;
    color: white;
  }
  @media (max-width: 900px) {
    .benefit-grid,
    .pillar-grid {
      grid-template-columns: 1fr 1fr;
    }
    .benefit-grid article:nth-child(2) {
      border-right: 0;
    }
    .benefit-grid article:nth-child(n + 3) {
      border-top: 1px solid var(--grey-200);
    }
    .partner-pathway {
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
    }
    .pathway-line {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .identity-inner,
    .opportunities-layout,
    .clubs-grid,
    .community-grid,
    .cta-grid,
    .evaluation-block {
      grid-template-columns: 1fr;
    }
    .identity-inner {
      align-items: flex-start;
      padding-block: 16px;
    }
    .identity-inner > p {
      padding-left: 72px;
    }
    .opportunities-layout,
    .clubs-grid,
    .community-grid,
    .cta-grid,
    .evaluation-block {
      gap: 38px;
    }
    .opportunities-heading {
      position: static;
    }
    .clubs-grid figure {
      order: -1;
    }
    .evaluation-block ul {
      grid-template-columns: 1fr 1fr;
    }
    .partner-pathway {
      grid-template-columns: 1fr 1fr;
    }
    .community-grid figure {
      aspect-ratio: 16/10;
    }
  }
  @media (max-width: 520px) {
    .benefit-grid,
    .pillar-grid,
    .partner-pathway,
    .evaluation-block ul {
      grid-template-columns: 1fr;
    }
    .benefit-grid article,
    .benefit-grid article:nth-child(2) {
      border-right: 0;
      border-top: 1px solid var(--grey-200);
    }
    .benefit-grid article:first-child {
      border-top: 0;
    }
    .identity-inner > p {
      padding-left: 0;
    }
    .cta-actions {
      display: grid;
    }
    .cta-actions :global(.button) {
      width: 100%;
    }
  }
</style>
