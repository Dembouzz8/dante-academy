---
import { Image } from 'astro:assets';
import academyLogo from '../assets/brand/dante-football-academy-new.png';
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Dante Football Academy"
  description="The requested page could not be found."
  robots="noindex, follow"
  canonical={false}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__number" aria-hidden="true">404</div>
    <div class="container not-found__inner">
      <Image
        class="not-found__shield"
        src={academyLogo}
        alt="Dante Football Academy"
        width={80}
        height={80}
        loading="eager"
      />

      <div class="not-found__content">
        <p class="eyebrow">Error 404</p>
        <h1 id="not-found-title">Page Not Found</h1>
        <p class="not-found__lead">Looks like this move went offside.</p>
        <p class="not-found__body">
          The page you're looking for could not be found. It may have moved,
          changed or no longer be available.
        </p>
        <div class="not-found__actions">
          <Button href="/">Back to Home</Button>
          <Button href="/contact/" variant="outline">Contact the Academy</Button
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(520px, calc(100svh - 90px), 680px);
    overflow: hidden;
    background: var(--navy-950);
    color: var(--white);
  }

  .not-found::after {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    width: min(36vw, 520px);
    height: 7px;
    background: var(--orange-500);
    content: '';
  }

  .not-found__number {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: clamp(16px, 5vw, 80px);
    color: rgba(255, 255, 255, 0.055);
    font:
      800 clamp(15rem, 34vw, 31rem) / 0.72 'Barlow Condensed',
      sans-serif;
    letter-spacing: -0.055em;
    pointer-events: none;
    transform: translateY(-50%);
    white-space: nowrap;
    user-select: none;
  }

  .not-found__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 80px minmax(0, 650px);
    align-items: start;
    align-content: center;
    gap: clamp(28px, 4vw, 54px);
    padding-block: clamp(64px, 8vw, 96px);
  }

  .not-found__shield {
    width: 80px;
    height: 80px;
    object-fit: contain;
  }

  .not-found__content {
    min-width: 0;
  }

  .not-found h1 {
    max-width: 650px;
    margin: 0;
    font:
      800 clamp(4rem, 8vw, 7rem) / 0.84 'Barlow Condensed',
      sans-serif;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .not-found__lead {
    margin: 25px 0 0;
    color: var(--off-white);
    font:
      600 clamp(1.45rem, 2.6vw, 2rem) / 1.12 'Barlow Condensed',
      sans-serif;
  }

  .not-found__body {
    max-width: 570px;
    margin: 14px 0 0;
    color: #c3c7d2;
    font-size: 0.98rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .not-found__actions :global(.button--outline) {
    color: var(--white);
  }

  @media (max-width: 640px) {
    .not-found {
      min-height: 560px;
    }

    .not-found__number {
      top: 38%;
      right: 50%;
      font-size: clamp(10rem, 44vw, 12rem);
      transform: translate(50%, -50%);
    }

    .not-found__inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block: 54px 64px;
    }

    .not-found__shield {
      width: 68px;
      height: 68px;
    }

    .not-found h1 {
      font-size: clamp(2.8rem, 12vw, 3.8rem);
    }

    .not-found__lead {
      margin-top: 22px;
    }

    .not-found__body {
      padding-right: 8px;
    }

    .not-found__actions {
      display: grid;
    }

    .not-found__actions :global(.button) {
      width: 100%;
    }
  }
</style>
