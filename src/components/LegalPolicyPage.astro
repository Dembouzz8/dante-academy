---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { PolicySection } from '../data/policies';
import { contact } from '../data/contact';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  effectiveDate?: string;
  lastUpdated?: string;
  version?: string;
  registrationNumber?: string;
  sections: readonly PolicySection[];
  privacyContact?: boolean;
}

const {
  title,
  description,
  effectiveDate,
  lastUpdated,
  version,
  registrationNumber,
  sections,
  privacyContact = false,
} = Astro.props;
---

<BaseLayout title={`${title} | ${site.name}`} description={description}>
  <header class="legal-hero">
    <div class="container legal-hero-grid">
      <div>
        <p class="eyebrow">Policies &amp; safeguarding</p>
        <h1>{title}</h1>
      </div>
      <dl class="policy-meta">
        <div><dt>Organisation</dt><dd>{site.legalName}</dd></div>
        {
          registrationNumber && (
            <div>
              <dt>Registration</dt>
              <dd>{registrationNumber}</dd>
            </div>
          )
        }
        {
          version && (
            <div>
              <dt>Version</dt>
              <dd>{version}</dd>
            </div>
          )
        }
        {
          effectiveDate && (
            <div>
              <dt>Effective date</dt>
              <dd>{effectiveDate}</dd>
            </div>
          )
        }
        {
          lastUpdated && (
            <div>
              <>
                <dt>Last updated</dt>
                <dd>{lastUpdated}</dd>
              </>
            </div>
          )
        }
      </dl>
    </div>
  </header>

  <div class="container legal-layout">
    <nav class="section-nav" aria-label={`${title} sections`}>
      <p>On this page</p>
      <ol>
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="legal-copy">
      {
        sections.map((section, index) => (
          <section id={section.id}>
            <p class="section-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.id === 'contact' && (
              <address>
                {privacyContact && <strong>Privacy Officer</strong>}
                <strong>{site.legalName}</strong>
                <span>{site.location}</span>
                <a href={contact.emailHref}>{contact.email}</a>
              </address>
            )}
          </section>
        ))
      }
    </article>
  </div>
</BaseLayout>

<style>
  .legal-hero {
    padding: 128px 0 72px;
    background: var(--navy-950);
    color: white;
    border-bottom: 5px solid var(--orange-500);
  }
  .legal-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr);
    gap: 8%;
    align-items: end;
  }
  h1 {
    max-width: 850px;
    margin: 12px 0 0;
    font: 800 clamp(3.4rem, 8vw, 6.8rem)/0.86 'Barlow Condensed';
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .policy-meta {
    margin: 0;
    padding-left: 28px;
    border-left: 3px solid var(--orange-500);
  }
  .policy-meta div + div {
    margin-top: 14px;
  }
  .policy-meta dt {
    color: #9fa4b5;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .policy-meta dd {
    margin: 3px 0 0;
    font-size: 0.88rem;
  }
  .legal-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 720px);
    gap: clamp(48px, 8vw, 110px);
    align-items: start;
    padding-block: 80px 110px;
  }
  .section-nav {
    position: sticky;
    top: 24px;
  }
  .section-nav > p {
    margin: 0 0 16px;
    color: var(--purple-700);
    font: 700 0.72rem 'Inter';
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .section-nav ol {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--grey-200);
  }
  .section-nav a {
    display: block;
    padding: 9px 0;
    border-bottom: 1px solid var(--grey-200);
    color: var(--grey-600);
    font-size: 0.76rem;
  }
  .section-nav a:hover {
    color: var(--orange-600);
  }
  .legal-copy section {
    scroll-margin-top: 24px;
    padding-bottom: 44px;
  }
  .legal-copy section + section {
    padding-top: 44px;
    border-top: 1px solid var(--grey-200);
  }
  .section-number {
    margin: 0 0 8px;
    color: var(--orange-600);
    font: 700 0.7rem 'Inter';
    letter-spacing: 0.12em;
  }
  .legal-copy h2 {
    margin: 0 0 18px;
    color: var(--navy-900);
    font: 700 clamp(2rem, 4vw, 2.7rem)/1 'Barlow Condensed';
    text-transform: uppercase;
  }
  .legal-copy p:not(.section-number) {
    margin: 0;
    color: #414655;
    font-size: 1rem;
    line-height: 1.8;
  }
  .legal-copy p + p {
    margin-top: 16px;
  }
  address {
    display: grid;
    gap: 5px;
    margin-top: 20px;
    padding: 24px;
    background: var(--off-white);
    border-left: 3px solid var(--orange-500);
    font-style: normal;
  }
  address a {
    width: fit-content;
    margin-top: 8px;
    color: var(--blue-700);
    font-weight: 700;
  }
  @media (max-width: 800px) {
    .legal-hero {
      padding: 104px 0 58px;
    }
    .legal-hero-grid,
    .legal-layout {
      grid-template-columns: 1fr;
    }
    .policy-meta {
      margin-top: 12px;
    }
    .legal-layout {
      gap: 52px;
      padding-block: 60px 80px;
    }
    .section-nav {
      position: static;
      columns: 2;
      column-gap: 28px;
    }
    .section-nav > p {
      column-span: all;
    }
  }
  @media (max-width: 520px) {
    h1 {
      overflow-wrap: anywhere;
      font-size: clamp(2.75rem, 14vw, 4rem);
    }
    .section-nav {
      columns: 1;
    }
    .legal-copy section {
      padding-bottom: 34px;
    }
    .legal-copy section + section {
      padding-top: 34px;
    }
  }
</style>
