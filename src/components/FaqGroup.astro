---
import type { FaqCategory } from '../data/faq';
import { programmes } from '../data/programmes';
import { contact } from '../data/contact';

interface Props {
  category: FaqCategory;
  index: number;
}

const { category, index } = Astro.props;
---

<section
  class:list={['faq-group', { 'faq-group--alternate': index % 2 === 1 }]}
  aria-labelledby={`${category.id}-title`}
>
  <div class="container faq-group-grid">
    <header>
      <p class="eyebrow">{category.eyebrow}</p>
      <h2 id={`${category.id}-title`}>{category.title}</h2>
    </header>
    <div class="disclosure-list">
      {
        category.questions.map((item) => (
          <article class="disclosure">
            <h3>
              <button
                type="button"
                aria-expanded="true"
                aria-controls={`${item.id}-answer`}
              >
                <span>{item.question}</span>
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M10 4v12"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
            </h3>
            <div class="answer" id={`${item.id}-answer`}>
              {item.answer && <p>{item.answer}</p>}
              {item.kind === 'age-groups' && (
                <>
                  <p>
                    Dante Football Academy supports the following age groups
                    across five development stages:
                  </p>
                  <ul>
                    {programmes.map((programme) =>
                      programme.squads.map((squad) => (
                        <li>
                          <strong>{squad.squad}:</strong>{' '}
                          {squad.ages.replace('Age ', 'ages ')}
                        </li>
                      )),
                    )}
                  </ul>
                </>
              )}
              {item.kind === 'development-stages' && (
                <ul>
                  {programmes.map((programme) => (
                    <li>
                      <strong>{programme.name}:</strong>{' '}
                      {programme.squads
                        .map(
                          (squad) =>
                            `${squad.squad}, ${squad.ages.toLowerCase()}`,
                        )
                        .join(' and ')}
                    </li>
                  ))}
                </ul>
              )}
              {item.kind === 'location' && (
                <address>
                  {contact.addressLines.map((line) => (
                    <span>{line}</span>
                  ))}
                </address>
              )}
              {item.kind === 'contact' && (
                <div class="contact-answer">
                  <p>
                    <strong>Telephone</strong>
                    {contact.phones.map((phone) => (
                      <a href={phone.href}>{phone.display}</a>
                    ))}
                  </p>
                  <p>
                    <strong>WhatsApp</strong>
                    <a
                      href={contact.whatsapp.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {contact.whatsapp.display}
                    </a>
                  </p>
                  <p>
                    <strong>Email</strong>
                    <a href={contact.emailHref}>{contact.email}</a>
                  </p>
                </div>
              )}
              {item.items && (
                <ul>
                  {item.items.map((listItem) => (
                    <li>{listItem}</li>
                  ))}
                </ul>
              )}
              {item.link && (
                <a class="answer-link" href={item.link.href}>
                  {item.link.label}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-group {
    padding: var(--section-space) 0;
    background: var(--white);
  }
  .faq-group--alternate {
    background: var(--off-white);
  }
  .faq-group-grid {
    display: grid;
    grid-template-columns: minmax(230px, 0.48fr) minmax(0, 1fr);
    gap: 9%;
    align-items: start;
  }
  header {
    position: sticky;
    top: 24px;
  }
  h2 {
    max-width: 420px;
    margin: 0;
    color: var(--navy-900);
    font: 700 clamp(2.4rem, 4vw, 3.8rem)/0.94 'Barlow Condensed';
    text-transform: uppercase;
  }
  .disclosure-list {
    border-top: 1px solid var(--navy-900);
  }
  .disclosure {
    border-bottom: 1px solid var(--grey-200);
  }
  h3 {
    margin: 0;
  }
  button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24px;
    gap: 24px;
    align-items: center;
    width: 100%;
    min-height: 72px;
    padding: 19px 4px;
    border: 0;
    background: transparent;
    color: var(--navy-900);
    text-align: left;
    cursor: pointer;
    font: 700 clamp(1.15rem, 2vw, 1.4rem)/1.2 'Barlow Condensed';
  }
  button:hover {
    color: var(--orange-600);
  }
  button:focus-visible {
    outline: 3px solid var(--orange-500);
    outline-offset: 4px;
  }
  button svg {
    width: 20px;
    height: 20px;
    transition: transform 0.2s ease;
  }
  button[aria-expanded='true'] svg {
    transform: rotate(45deg);
  }
  .answer {
    max-width: 70ch;
    padding: 0 42px 24px 4px;
    color: var(--grey-600);
    font-size: 0.9rem;
  }
  .answer[hidden] {
    display: none;
  }
  .answer p:first-child {
    margin-top: 0;
  }
  .answer ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 24px;
    padding-left: 18px;
  }
  address,
  address span,
  .contact-answer strong,
  .contact-answer a {
    display: block;
  }
  address {
    font-style: normal;
  }
  .contact-answer {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .contact-answer p {
    min-width: 0;
    margin: 0;
  }
  .contact-answer a {
    overflow-wrap: anywhere;
    color: var(--blue-700);
  }
  .answer-link {
    display: inline-block;
    margin-top: 10px;
    color: var(--blue-700);
    font-weight: 700;
  }
  .answer-link:hover {
    color: var(--orange-600);
  }
  @media (max-width: 760px) {
    .faq-group-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }
    header {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .answer ul,
    .contact-answer {
      grid-template-columns: 1fr;
    }
    .answer {
      padding-right: 4px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button svg {
      transition: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('.disclosure')
    .forEach((disclosure) => {
      const button = disclosure.querySelector<HTMLButtonElement>('button');
      const answer = disclosure.querySelector<HTMLElement>('.answer');

      if (!button || !answer) return;

      button.setAttribute('aria-expanded', 'false');
      answer.hidden = true;

      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        answer.hidden = expanded;
      });
    });
</script>
