---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg
  class="social-icon"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'instagram' && (
      <>
        <rect
          x="3"
          y="3"
          width="18"
          height="18"
          rx="5"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <circle
          cx="12"
          cy="12"
          r="4"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
      </>
    )
  }
  {
    name === 'facebook' && (
      <path
        d="M14.5 21v-8h2.8l.5-3h-3.3V8.1c0-.9.3-1.6 1.7-1.6H18V3.8c-.7-.1-1.5-.2-2.3-.2-2.4 0-4.1 1.5-4.1 4.3V10H9v3h2.6v8h2.9Z"
        fill="currentColor"
      />
    )
  }
  {
    name === 'youtube' && (
      <>
        <rect
          x="2.5"
          y="5.5"
          width="19"
          height="13"
          rx="4"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <path d="m10 9 5 3-5 3V9Z" fill="currentColor" />
      </>
    )
  }
  {
    name === 'x' && (
      <path
        d="M5 4 19 20M19 4 5 20"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    )
  }
  {
    name === 'tiktok' && (
      <path
        d="M14 4v10.5a4.5 4.5 0 1 1-3.2-4.3M14 4c.7 2.3 2.2 3.7 4.5 4"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path
          d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        />
        <path
          d="M9 8.5c.8 2.7 2 4 4.8 5l1.2-1.1 2 1c-.2 1.3-1.1 2.1-2.4 2.1-3.7-.4-6.7-3.4-7.1-7.1C7.5 7.1 8.3 6.2 9.6 6l1 2-1.6.5Z"
          fill="currentColor"
        />
      </>
    )
  }
</svg>

<style>
  .social-icon {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    pointer-events: none;
  }
</style>
