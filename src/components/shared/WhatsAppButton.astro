---
import { contact } from '../../data/contact';
---

<a
  class="whatsapp-button"
  href={contact.whatsapp.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Dante on WhatsApp"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
    <path
      d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.45L3.5 20.5l1.42-4.25A8.5 8.5 0 1 1 20.5 11.7Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
    <path
      d="M8.2 7.6c.25-.3.52-.32.8-.32h.35c.2 0 .4.05.5.35l.75 1.8c.1.28.05.48-.1.68l-.58.7c-.14.16-.1.34 0 .5.48.84 1.2 1.55 2.05 2.04.17.1.35.14.5 0l.72-.86c.17-.2.4-.24.62-.14l1.82.86c.25.12.38.3.34.55-.08.53-.32 1.2-.8 1.58-.47.38-1.13.58-1.77.48-1.2-.18-2.65-.85-4.2-2.4-1.3-1.3-2.05-2.65-2.22-3.82-.1-.72.2-1.45.72-2Z"
      fill="currentColor"></path>
  </svg>
</a>

<style>
  .whatsapp-button {
    position: fixed;
    z-index: 15;
    right: clamp(18px, 2.5vw, 32px);
    bottom: clamp(20px, 3vw, 36px);
    display: grid;
    width: 50px;
    height: 50px;
    border: 2px solid white;
    border-radius: 50%;
    background: #187c53;
    color: white;
    place-items: center;
    box-shadow: 0 8px 24px rgb(7 12 36 / 25%);
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }
  .whatsapp-button:hover {
    background: #126843;
    transform: translateY(-2px);
  }
  .whatsapp-button svg {
    width: 25px;
    height: 25px;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .whatsapp-button {
      right: 16px;
      bottom: 18px;
      width: 46px;
      height: 46px;
    }
    .whatsapp-button svg {
      width: 23px;
      height: 23px;
    }
  }
</style>
