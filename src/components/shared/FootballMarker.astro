---
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}
const { variant = 'dark', class: className = '' } = Astro.props;
---

<svg
  class:list={['football-marker', `football-marker--${variant}`, className]}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="12" r="10.5" class="ball"></circle>
  <path
    class="panel panel--centre"
    d="m12 6.7 3.3 2.4-1.25 3.88h-4.1L8.7 9.1 12 6.7Z"></path>
  <path
    class="panel"
    d="m4.1 9.1 3.2-.05 1.05-3.1-2.2-1.35A10.5 10.5 0 0 0 4.1 9.1ZM17.85 4.6l-2.2 1.35 1.05 3.1 3.2.05a10.5 10.5 0 0 0-2.05-4.5ZM5.4 17.7l.45-2.55-2.6-1.88a10.4 10.4 0 0 0 2.15 4.43ZM18.6 17.7l-.45-2.55 2.6-1.88a10.4 10.4 0 0 1-2.15 4.43Z"
  ></path>
  <path
    class="panel panel--accent"
    d="m9.3 20.9 2.7-1.8 2.7 1.8A10.7 10.7 0 0 1 12 22c-.93 0-1.83-.12-2.7-.35Z"
  ></path>
  <path
    class="seam"
    d="m8.7 9.1-1.4-.05m8 0 1.4-.05m-6.75 3.98-1.8 2.17m5.9-2.17 1.8 2.17M12 6.7V4.1m0 15v-2.7"
  ></path>
</svg>
<style>
  .football-marker {
    display: inline-block;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    overflow: visible;
    pointer-events: none;
  }
  .ball {
    fill: var(--off-white);
    stroke: var(--navy-900);
    stroke-width: 1.4;
  }
  .panel {
    fill: var(--navy-900);
  }
  .panel--accent {
    fill: var(--orange-500);
  }
  .seam {
    fill: none;
    stroke: var(--navy-900);
    stroke-width: 1;
    stroke-linecap: round;
  }
  .football-marker--light .ball {
    stroke: var(--off-white);
  }
  .football-marker--light .panel {
    fill: var(--navy-900);
  }
  .football-marker--light .panel--accent {
    fill: var(--orange-500);
  }
</style>
