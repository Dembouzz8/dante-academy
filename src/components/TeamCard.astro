---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  name: string;
  role: string;
  image: ImageMetadata | '';
  objectPosition: string;
}
const { name, role, image, objectPosition } = Astro.props;
const initials = name
  .replace(/\([^)]*\)/g, '')
  .split(' ')
  .filter((word) => !word.endsWith('.'))
  .map((word) => word[0])
  .slice(0, 2)
  .join('');
---

<article class="team-card">
  <div class="team-card-image">
    {
      image ? (
        <Image
          src={image}
          alt={`Portrait of ${name}`}
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 50vw, (max-width: 1000px) 33vw, 25vw"
          loading="lazy"
          style={`object-position:${objectPosition}`}
        />
      ) : (
        <div class="team-fallback" aria-hidden="true">
          <span>{initials}</span>
        </div>
      )
    }
    {image && <span class="dante-diagonal-accent" aria-hidden="true" />}
  </div>
  <h3>{name}</h3><p>{role}</p>
</article>
<style>
  .team-card {
    min-width: 0;
  }
  .team-card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/5;
    background: linear-gradient(
      145deg,
      var(--blue-700),
      var(--navy-900) 55%,
      var(--purple-700)
    );
  }
  .team-card-image::after {
    content: '';
    position: absolute;
    z-index: 3;
    inset: auto 0 0;
    height: 5px;
    background: var(--orange-500);
  }
  .team-card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .team-fallback::before {
    content: '';
    position: absolute;
    inset: 9%;
    border: 1px solid rgb(255 255 255 / 18%);
  }
  .team-fallback span {
    font: 800 clamp(5rem, 10vw, 9rem)/1 'Barlow Condensed';
    color: rgb(255 255 255 / 10%);
  }
  .team-card h3 {
    margin: 17px 0 5px;
    font: 700 1.35rem/1.05 'Barlow Condensed';
    text-transform: uppercase;
  }
  .team-card p {
    margin: 0;
    color: #aeb2c0;
    font-size: 0.76rem;
  }
</style>
