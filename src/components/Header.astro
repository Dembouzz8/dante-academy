---
import { Image } from 'astro:assets';
import logo from '../assets/brand/dante-football-academy-new.png';
import { navigation } from '../data/navigation';
import Button from './Button.astro';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === href : path.startsWith(href);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Dante Football Academy home">
      <Image
        src={logo}
        alt="Dante Football Academy"
        width={82}
        height={82}
        loading="eager"
      />
      <span>Dante <b>Football Academy</b></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a
            class:list={{ active: isActive(item.href) }}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <Button href="/register/" class="header-cta">Join the Academy</Button>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav
    class="mobile-nav"
    id="mobile-menu"
    aria-label="Mobile navigation"
    hidden
  >
    {
      navigation.map((item) => (
        <a
          class:list={{ active: isActive(item.href) }}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <Button href="/register/">Join the Academy</Button>
  </nav>
</header>
<script>
  const header = document.querySelector('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('#mobile-menu');

  const closeMenu = () => {
    if (!button || !menu || menu.hidden) return;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', 'Open menu');
    menu.hidden = true;
  };

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || menu?.hidden) return;
    closeMenu();
    button?.focus();
  });
</script>
