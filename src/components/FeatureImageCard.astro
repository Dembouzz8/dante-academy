---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  objectPosition?: string;
  label: string;
  heading: string;
  description: string;
}

const {
  image,
  alt,
  objectPosition = '50% center',
  label,
  heading,
  description,
} = Astro.props;
---

<article class:list={['feature-image-card', { 'has-image': image }]}>
  {
    image && (
      <Image
        src={image}
        alt={alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 1240px) calc(100vw - 40px), 1200px"
        loading="lazy"
        style={`object-position:${objectPosition}`}
      />
    )
  }
  <div class="feature-image-overlay" aria-hidden="true"></div>
  <span class="dante-diagonal-accent" aria-hidden="true"></span>
  <div class="feature-image-content">
    <p>{label}</p>
    <h3>{heading}</h3>
    <span>{description}</span>
  </div>
</article>

<style>
  .feature-image-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: 16/7;
    min-height: 390px;
    background: linear-gradient(
      145deg,
      var(--blue-700),
      var(--navy-900) 58%,
      var(--purple-700)
    );
    color: white;
  }
  .feature-image-card::after {
    content: '';
    position: absolute;
    z-index: 2;
    inset: auto 0 0;
    width: 22%;
    height: 5px;
    background: var(--orange-500);
  }
  .feature-image-card > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature-image-overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(7 12 36 / 88%) 0%,
        rgb(7 12 36 / 52%) 48%,
        rgb(7 12 36 / 18%) 100%
      ),
      linear-gradient(0deg, rgb(7 12 36 / 68%), transparent 65%);
  }
  .feature-image-content {
    position: absolute;
    z-index: 3;
    left: clamp(24px, 5vw, 64px);
    bottom: clamp(28px, 5vw, 58px);
    max-width: 590px;
  }
  .feature-image-content p {
    margin: 0 0 10px;
    color: var(--orange-500);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .feature-image-content h3 {
    margin: 0;
    font: 700 clamp(2.5rem, 5vw, 4.4rem)/0.92 'Barlow Condensed';
    text-transform: uppercase;
  }
  .feature-image-content span {
    display: block;
    max-width: 560px;
    margin-top: 14px;
    color: var(--off-white);
    font-size: 0.92rem;
  }
  @media (max-width: 640px) {
    .feature-image-card {
      aspect-ratio: 4/5;
      min-height: 0;
    }
    .feature-image-card > :global(img) {
      object-position: 58% center !important;
    }
    .feature-image-overlay {
      background: linear-gradient(
        0deg,
        rgb(7 12 36 / 96%) 0%,
        rgb(7 12 36 / 75%) 42%,
        rgb(7 12 36 / 8%) 76%
      );
    }
    .feature-image-content {
      left: 22px;
      right: 22px;
      bottom: 30px;
    }
    .feature-image-content h3 {
      font-size: 2.65rem;
    }
  }
</style>
