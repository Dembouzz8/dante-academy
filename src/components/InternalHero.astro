---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  objectPosition?: string;
}
const {
  eyebrow,
  title,
  description,
  image,
  objectPosition = '50% center',
} = Astro.props;
---

<section class:list={['internal-hero', { 'has-image': image }]}>
  {
    image && (
      <Picture
        src={image}
        alt=""
        widths={[768, 1024, 1440]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        style={`object-position:${objectPosition}`}
      />
    )
  }
  <div class="internal-hero-overlay" aria-hidden="true"></div>
  <div class="container internal-hero-content">
    <p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p>
  </div>
</section>
<style>
  .internal-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: 520px;
    display: grid;
    align-items: end;
    background: linear-gradient(
      125deg,
      var(--navy-950),
      var(--navy-900) 65%,
      var(--purple-700)
    );
    color: white;
  }
  .internal-hero::after {
    content: '';
    position: absolute;
    z-index: 2;
    left: 0;
    bottom: 0;
    width: 24%;
    height: 5px;
    background: var(--orange-500);
  }
  .internal-hero :global(picture),
  .internal-hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .internal-hero :global(img) {
    object-fit: cover;
  }
  .internal-hero-overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(7 12 36 / 96%),
        rgb(7 12 36 / 78%) 48%,
        rgb(7 12 36 / 28%)
      ),
      linear-gradient(0deg, rgb(7 12 36 / 75%), transparent 65%);
  }
  .internal-hero-content {
    position: relative;
    z-index: 3;
    padding-block: 90px 74px;
  }
  .internal-hero h1 {
    max-width: 900px;
    margin: 12px 0 22px;
    font: 800 clamp(3.8rem, 9vw, 7.5rem)/0.84 'Barlow Condensed';
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .internal-hero-content > p:last-child {
    max-width: 650px;
    margin: 0;
    color: var(--off-white);
    font-size: 1.02rem;
  }
  @media (max-width: 640px) {
    .internal-hero {
      min-height: 560px;
    }
    .internal-hero-content {
      padding-block: 78px 62px;
    }
    .internal-hero-overlay {
      background: linear-gradient(0deg, rgb(7 12 36 / 96%), rgb(7 12 36 / 68%));
    }
    .internal-hero h1 {
      font-size: 3.75rem;
    }
  }
</style>
