---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'light' | 'section';
  class?: string;
}
import ArrowUpRight from './shared/ArrowUpRight.astro';
const { href, variant = 'primary', class: className = '' } = Astro.props;
---

<a class:list={['button', `button--${variant}`, className]} href={href}
  ><slot /><ArrowUpRight /></a
>
